# Everything here is optional if you prefer the in-app setup screen.
# These are read at build time, so set them in your host's settings and redeploy.

# Liveblocks public key (starts with pk_). Without it the app asks for one on first run.
VITE_LIVEBLOCKS_PUBLIC_KEY=

# Image uploads: Cloudinary cloud name and an UNSIGNED upload preset.
# Without them the image buttons are hidden (they can also be set later in Board settings).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Board name. Change it to start a fresh board on the same Liveblocks project.
VITE_ROOM_ID=
